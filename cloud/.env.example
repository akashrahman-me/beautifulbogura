# ---- server ----
NODE_ENV=development
PORT=4000
# Public URL of this API (OAuth callbacks are built from it).
API_URL=http://localhost:4000
LOG_LEVEL=info

# ---- database ----
# Local: `npm run db` starts a single-node replica set on this URI (transactions need a replica set).
MONGODB_URI=mongodb://127.0.0.1:27017/beautifulbogura?replicaSet=rs0

# ---- the two front ends (CORS + where sign-in returns) ----
CLIENT_URL=http://localhost:3000
CONSOLE_URL=http://localhost:3001

# ---- tokens (each at least 32 random characters: `openssl rand -base64 48`) ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
OAUTH_STATE_SECRET=change-me-oauth-state-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30
# false only for plain-http local development
COOKIE_SECURE=false

# ---- first admins: these verified emails become admins on first sign-in ----
ADMIN_EMAILS=

# ---- social sign-in (leave empty until set up) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 key contents, with \n for newlines
APPLE_PRIVATE_KEY=

# Development only: a local sign-in page stands in for providers that are not configured.
# Refused when NODE_ENV=production.
AUTH_DEV_LOGIN=true

# ---- uploads ----
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5

# ---- web push (optional): `npx web-push generate-vapid-keys` ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- weather (Open-Meteo, no key) ----
WEATHER_LAT=24.8465
WEATHER_LON=89.3776
